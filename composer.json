{
	"name": "towfique-elahe/pika-pos",
	"description": "Point of Sale for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Towfique Elahe",
			"homepage": "https://towfiqueelahe.com"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-stubs/woocommerce-stubs": "^11.0",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^12.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"check": [
			"@lint",
			"@analyse"
		],
		"test": "phpunit"
	},
	"scripts-descriptions": {
		"lint": "Check PHP against the WordPress Coding Standards.",
		"lint:fix": "Auto-fix what PHPCS can fix on its own.",
		"analyse": "Static analysis with WordPress and WooCommerce stubs loaded.",
		"test": "Run the integration tests against the local Studio site."
	}
}
